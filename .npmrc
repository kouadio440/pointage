# Empeche les dependances fantomes : un package ne peut importer que ce qu'il declare.
node-linker=isolated
strict-peer-dependencies=false
auto-install-peers=true

# Securite chaine d'approvisionnement : aucun script post-install n'est execute sans
# autorisation explicite (voir onlyBuiltDependencies dans pnpm-workspace.yaml si besoin).
enable-pre-post-scripts=false

# Reproductibilite : la CI echoue si le lockfile ne correspond pas aux manifests.
resolution-mode=highest
