# /etc/timora-payments/env — SERVEUR DE PAIEMENT (payments.timora.tech)
#
# Droits : 600, proprietaire root (systemd le lit au demarrage).
# Ne JAMAIS committer le fichier rempli, ne jamais l'envoyer par messagerie.
# Apres toute modification : sudo systemctl restart timora-payments
#
# IMPORTANT : utilisez des cles JoonaPay de production NOUVELLEMENT GENEREES.
# Les cles utilisees jusqu'ici (collees dans une conversation, conservees sur
# un poste personnel) sont a considerer comme compromises : revoquez-les.
# Les nouvelles cles ne doivent exister QUE dans ce fichier, sur le serveur
# d'IPv4 fixe 15.236.1.218 (la seule adresse en liste blanche JoonaPay).

# --- JoonaPay (production) ---------------------------------------------------
JOONAPAY_ENV=production
JOONAPAY_BASE_URL=https://apis.joonapay.com/api/v1/developer
JOONAPAY_CLIENT_KEY=
JOONAPAY_PRIVATE_KEY=
JOONAPAY_WEBHOOK_SECRET=
# Adresse declaree chez JoonaPay pour les notifications de paiement.
JOONAPAY_WEBHOOK_URL=https://payments.timora.tech/api/webhooks/joonapay
JOONAPAY_DEFAULT_COUNTRY=CI

# --- Timora --------------------------------------------------------------------
# Adresses de retour apres paiement (jamais de secret dans ces adresses).
TIMORA_APP_URL=https://www.timora.tech
# Secret partage avec Vercel (meme valeur des deux cotes), 32 caracteres au
# moins, genere par : node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
INTERNAL_PAYMENT_API_SECRET=

# --- Supabase ------------------------------------------------------------------
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# --- Ecoute locale (derriere Caddy, jamais exposee) ---------------------------
HOST=127.0.0.1
PORT=3000

# --- Test de production unique (100 XOF) ---------------------------------------
# A activer seulement pendant le test controle, puis remettre a false.
PRODUCTION_SMOKE_TEST_ENABLED=false
PRODUCTION_SMOKE_TEST_AMOUNT=100
PRODUCTION_SMOKE_TEST_MAX_USES=1
# Facultatif (double controle) : empreinte SHA-256 de l'adresse du compte de
# test, affichee par : node scripts/test-production.mjs activer <adresse>
PRODUCTION_SMOKE_TEST_ALLOWED_EMAIL_HASH=

# --- Messagerie (e-mail de bienvenue et recu) -----------------------------------
# Le meme fournisseur SMTP peut servir a Supabase Auth (codes de connexion).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM="Timora <facturation@timora.tech>"
EMAIL_REPLY_TO=

# --- Mentions de l'editeur sur le recu (affichees seulement si renseignees) ----
TIMORA_LEGAL_NAME=
TIMORA_LEGAL_ADDRESS=
TIMORA_LEGAL_IDS=
TIMORA_BILLING_CONTACT=
