# =============================================================================
#  Winner Pointage - Variables d'environnement
#
#  Copiez ce fichier en `.env` et renseignez les valeurs. `.env` est ignore par
#  git et ne doit JAMAIS etre committe. En production, ces valeurs sont injectees
#  au demarrage du conteneur (SSM / Doppler), jamais integrees a l'image.
#
#  Rotation des secrets : voir docs/RUNBOOK.md
# =============================================================================

NODE_ENV=development
TZ=UTC

# --- API ---------------------------------------------------------------------
API_PORT=3000
API_URL=http://localhost:3000
APP_URL=http://localhost:5173
WEB_URL=http://localhost:8080

# Origines autorisees en CORS, separees par une virgule.
# Ne JAMAIS mettre "*" ni refleter l'origine de la requete.
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# --- Base de donnees ---------------------------------------------------------
POSTGRES_USER=pointage
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=pointage
DATABASE_URL=postgresql://pointage:change-me-in-production@localhost:5432/pointage?schema=public

# --- Redis (sessions, limitation de debit, files BullMQ) ---------------------
REDIS_URL=redis://localhost:6379

# --- Stockage objet (MinIO en local, S3 en production) ----------------------
S3_ENDPOINT=http://localhost:9000
S3_REGION=eu-west-3
S3_BUCKET=pointage
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=change-me-in-production
# Force le style chemin, requis par MinIO.
S3_FORCE_PATH_STYLE=true

# --- Authentification --------------------------------------------------------
# Cles EdDSA au format PEM, encodees en base64. Generation :
#   node scripts/generate-jwt-keys.mjs
JWT_PRIVATE_KEY_B64=
JWT_PUBLIC_KEY_B64=
# Identifiant de la cle courante, pour la rotation sans coupure (JWKS a 2 cles).
JWT_KEY_ID=k1
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# Cle maitre de chiffrement applicatif (embeddings biometriques, secrets QR).
# 32 octets en base64. Generation : openssl rand -base64 32
ENCRYPTION_MASTER_KEY=

# --- Service de reconnaissance faciale --------------------------------------
# Joignable UNIQUEMENT depuis le reseau interne Docker.
FACE_SERVICE_URL=http://face:8000
FACE_SERVICE_TOKEN=change-me-in-production
FACE_MODEL_VERSION=buffalo_l-v1

# --- Envoi d'e-mails (Mailpit en local) -------------------------------------
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Winner Pointage <no-reply@pointage.ci>"

# --- Envoi de SMS (desactive tant qu'aucun operateur n'est choisi) ----------
SMS_PROVIDER=console
SMS_API_KEY=
SMS_SENDER=POINTAGE

# --- Antivirus (analyse des justificatifs et documents) ---------------------
CLAMAV_HOST=localhost
CLAMAV_PORT=3310

# --- Cartographie ------------------------------------------------------------
MAPTILER_API_KEY=

# --- Observabilite -----------------------------------------------------------
LOG_LEVEL=debug

# --- Supabase ----------------------------------------------------------------
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ACCESS_TOKEN=


# --- Paiement JoonaPay -------------------------------------------------------
# SERVEUR UNIQUEMENT : a renseigner dans les variables d'environnement Vercel
# (Settings > Environment Variables), jamais dans le code ni dans le navigateur.
# Les routes api/billing/* et api/webhooks/joonapay utilisent aussi
# SUPABASE_URL, SUPABASE_ANON_KEY et SUPABASE_SERVICE_ROLE_KEY ci-dessus.
#
# « sandbox » tant que la production n'est pas ouverte. La base doit etre dans
# le meme mode (table billing_settings) : sinon aucun paiement ne demarre.
JOONAPAY_ENV=sandbox
# Adresse affichee par le portail JoonaPay (« Environnement »), suivie de
# /v1/developer. Les cles doivent appartenir au MEME environnement : le portail
# ne cree que des cles de production ; les cles sandbox sont fournies par
# JoonaPay sur demande (docs.joonapay.com/fr/introduction, « Environnements »).
# Sandbox    : https://api-counter-demo.wejoona.com/api/v1/developer
# Production : https://apis.joonapay.com/api/v1/developer
JOONAPAY_BASE_URL=
JOONAPAY_CLIENT_KEY=
JOONAPAY_PRIVATE_KEY=
JOONAPAY_WEBHOOK_SECRET=
# Adresse HTTPS PUBLIQUE du webhook, identique a celle declaree sur la cle API
# JoonaPay. Jamais localhost ni une IP privee.
JOONAPAY_WEBHOOK_URL=https://www.timora.tech/api/webhooks/joonapay
# Pays de paiement (ISO 3166-1 alpha-2) quand celui de l'entreprise n'est pas
# ouvert au paiement en XOF chez JoonaPay.
JOONAPAY_DEFAULT_COUNTRY=CI
# Adresse publique du site : JoonaPay y renvoie le client apres paiement.
TIMORA_APP_URL=https://www.timora.tech
