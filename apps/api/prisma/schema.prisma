  companyId String @db.Uuid

  name      String
  contact   String?
  phone     String?
  email     String?
  address   String?
  latitude  Float?
  longitude Float?

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company Company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  visits  CommercialVisit[]

  @@unique([companyId, name])
  @@index([companyId, isActive])
  @@map("client")
}

/// Visite client. La position n'est captee QU'A l'arrivee et au depart : il n'y
/// a aucun suivi continu dans ce produit, ni ici ni ailleurs.
model CommercialVisit {
  id         String @id @default(uuid()) @db.Uuid
  companyId  String @db.Uuid
  employeeId String @db.Uuid
  clientId   String @db.Uuid

  plannedAt DateTime?

  arrivedAt     DateTime?
  arrivalLat    Float?
  arrivalLng    Float?
  departedAt    DateTime?
  departureLat  Float?
  departureLng  Float?

  summary        String?
  photoIds       String[] @default([])
  signatureFileId String? @db.Uuid
  signerName     String?

  status VisitStatus @default(PLANNED)

  validatedById String?   @db.Uuid
  validatedAt   DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)
  client   Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([companyId, employeeId, arrivedAt])
