//  TRANSVERSE
// =============================================================================

model Notification {
  id        String  @id @default(uuid()) @db.Uuid
  companyId String  @db.Uuid
  userId    String? @db.Uuid

  channel NotificationChannel @default(IN_APP)
  status  NotificationStatus  @default(QUEUED)

  /// Code de modele, pas un texte fige : les libelles vivent cote applicatif.
  templateCode String
  payload      Json    @default("{}")
  title        String
  body         String

  sentAt   DateTime?
  readAt   DateTime?
  failedAt DateTime?
  error    String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([companyId, userId, status, createdAt])
  @@map("notification")
}

model Report {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  type   ReportType
  format ReportFormat @default(PDF)
  status ReportStatus @default(QUEUED)

  periodFrom DateTime @db.Date
  periodTo   DateTime @db.Date
  /// Filtres appliques (site, departement, employe).
  filters Json @default("{}")

  fileId       String?   @db.Uuid
  generatedById String   @db.Uuid
  generatedAt  DateTime?
  /// Reference unique imprimee sur le document, verifiable.
  reference    String
  expiresAt    DateTime?
  error        String?

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, reference])
  @@index([companyId, type, createdAt])
  @@map("report")
}

model FileObject {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  kind FileKind
  /// Cle de stockage opaque. Le nom d'origine n'est JAMAIS utilise comme chemin.
  storageKey       String  @unique
  originalName     String?
  mimeType         String
  sizeBytes        Int
  /// SHA-256 du contenu, pour la deduplication et la preuve d'integrite.
  checksum         String?

  scanStatus ScanStatus @default(PENDING)
  scannedAt  DateTime?

  /// Date de purge automatique, posee selon la matrice de retention.
  purgeAfter DateTime?
  purgedAt   DateTime?

  uploadedById String?  @db.Uuid
  createdAt    DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, kind, createdAt])
  @@index([purgeAfter])
  @@map("file_object")
}

/// Journal d'audit. APPEND-ONLY, garanti au niveau des droits PostgreSQL :
/// le role applicatif n'a ni UPDATE ni DELETE sur cette table. La chaine de
/// hachage rend toute alteration detectable, meme par un administrateur base.
model AuditLog {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  actorId   String?   @db.Uuid
  actorRole UserRole?
  action    String
  entityType String
  entityId   String?  @db.Uuid

  /// Diffs, avec redaction par LISTE BLANCHE : un nouveau champ sensible est
  /// exclu par defaut, ce qui reste correct a mesure que le schema grossit.
  beforeValue Json?
  afterValue  Json?

  ip        String?
  userAgent String?
  requestId String?

  /// Chaine de hachage par entreprise : hash = H(prevHash || contenu).
  prevHash String?
  hash     String

  createdAt DateTime @default(now())

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId])
  @@index([companyId, actorId, createdAt])
  @@map("audit_log")
}

model SupportTicket {
  id        String @id @default(uuid()) @db.Uuid
  companyId String @db.Uuid

  subject  String
  body     String
  status   TicketStatus   @default(OPEN)
  priority TicketPriority @default(NORMAL)

  openedById   String  @db.Uuid
  assignedToId String? @db.Uuid

  resolvedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, status, priority])
  @@map("support_ticket")
}

/// Journal des actions de la PLATEFORME (super admin). Volontairement separe du
/// journal des entreprises : un super admin n'ecrit pas dans l'audit d'un client.
model PlatformAuditLog {
  id String @id @default(uuid()) @db.Uuid

  actorId    String  @db.Uuid
  action     String
  targetCompanyId String? @db.Uuid
  entityType String
  entityId   String?
  metadata   Json?

  ip        String?
  requestId String?
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([targetCompanyId, createdAt])
  @@map("platform_audit_log")
}
